    "agent.enroll.input": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentInput"
        }
      },
      "required": [
        "opId",
        "agent"
      ],
      "additionalProperties": false
    },
    "agent.enroll.output": {
      "type": "object",
      "properties": {
        "publicKey": {
          "type": "string"
        }
      },
      "required": [
        "publicKey"
      ],
      "additionalProperties": false
    },
    "lane.open.input": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "brief": {
          "type": "boolean"
        }
      },
      "required": [
        "opId",
        "task",
        "agent"
      ],
      "additionalProperties": false
    },
    "lane.open.output": {
      "type": "object",
      "properties": {
        "laneThread": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "briefing": {
          "type": "object",
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "omitted": {
              "type": "integer",
              "minimum": 0
            },
            "annotations": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  },
                  "annotationId": {
                    "type": "string"
                  },
                  "revisionId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "attribution": {
                    "type": "string"
                  }
                },
                "required": [
                  "target",
                  "scope",
                  "annotationId",
                  "revisionId",
                  "kind",
                  "content",
                  "attribution"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "hash",
            "omitted",
            "annotations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "laneThread",
        "leaseId"
      ],
      "additionalProperties": false
    },
    "ingest.input": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string"
        },
        "items": {
          "type": "array",
