                "additionalProperties": false
              },
              "ref": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              }
            },
            "required": [
              "task",
              "agent",
              "fork",
              "ref",
              "sha"
            ],
            "additionalProperties": false
          }
        },
        "runTests": {
          "type": "boolean"
        },
        "isolateUnreviewed": {
          "type": "boolean"
        }
      },
      "required": [
        "opId",
        "items",
        "runTests"
