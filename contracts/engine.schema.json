  "$defs": {
    "AgentInput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "reviewer"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "displayName"
      ],
      "additionalProperties": false
    },
    "Agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "reviewer"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "displayName",
        "publicKey"
      ],
      "additionalProperties": false
    },
    "Tests": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error",
            "skipped",
            "pending"
          ]
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "enum": [
            "reviewed fixture",
            "isolated sandbox",
            "isolated sandbox (local fixture)"
          ]
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "observation": {
          "type": "object",
          "properties": {
            "publicKey": {
              "type": "string"
            },
            "payload": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            }
          },
          "required": [
            "publicKey",
            "payload",
            "signature"
          ],
          "additionalProperties": false
        },
        "failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "excerpt": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "status",
        "passed",
        "failed",
        "summary",
        "durationMs"
      ],
      "additionalProperties": false
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "with"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "sourceSha": {
          "type": "string"
        },
        "treeSha": {
          "type": "string"
        },
        "parentSha": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "diffstat": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "insertions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "files",
            "insertions",
            "deletions"
          ],
          "additionalProperties": false
        },
        "tests": {
          "$ref": "#/$defs/Tests"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Conflict"
          }
        },
        "signedBy": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string"
        },
        "combined": {
          "$ref": "#/$defs/Combined"
        }
      },
      "required": [
        "task",
        "agent",
        "state",
        "sourceSha",
        "treeSha",
        "parentSha",
        "subject",
        "diffstat",
        "conflicts",
        "signedBy",
        "capturedAt"
      ],
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "reviewer"
          ]
        },
        "body": {
          "type": "string"
        },
        "replyTo": {
          "type": "string"
        },
        "heddleDiscussion": {
          "type": "string"
        },
        "signedBy": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "task",
        "author",
        "kind",
        "body",
        "heddleDiscussion",
        "signedBy",
        "at"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "decider": {
          "type": "string"
        },
        "pick": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolutionState": {
          "type": "string"
        },
        "landState": {
          "type": "string"
        },
        "mainSha": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "combined": {
          "type": "object",
          "properties": {
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "treeSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "mainSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "sha",
            "treeSha",
            "mainSha",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "task",
        "decider",
        "pick",
        "rationale",
        "alternatives",
        "resolutionState",
        "landState",
        "mainSha",
        "at"
      ],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "perCandidate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "approve",
                  "concerns"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "verdict",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "pick": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "pick",
            "why"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "perCandidate",
        "model"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "init.input": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "canonical": {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string"
            }
          },
          "required": [
            "remote"
          ],
          "additionalProperties": false
        },
        "seed": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "template": {
                  "const": "demo"
                }
              },
              "required": [
                "template"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "importUrl": {
                  "type": "string"
                },
                "snapshot": {
                  "type": "boolean"
                }
              },
              "required": [
                "importUrl"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "opId",
        "project",
        "canonical",
        "seed"
      ],
      "additionalProperties": false
    },
    "init.output": {
      "type": "object",
      "properties": {
        "mainState": {
          "type": "string"
        },
        "mainSha": {
          "type": "string"
        },
        "imported": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "tree": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "url",
            "sha",
            "tree"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mainState",
        "mainSha"
      ],
      "additionalProperties": false
    },
    "task.create.input": {
      "type": "object",
