# SPDX-License-Identifier: Apache-2.0
# Layer reviewed engine JavaScript onto the retained, already-verified engine image.
# The base has no shell, so permissions are normalized in a throwaway stage: the
# trusted-manifest check requires root-owned files that group/other cannot write.
FROM docker.io/library/busybox:1.37 AS files
COPY engine/ /out/opt/engine/
COPY contracts/ /out/opt/contracts/
COPY demo/ /out/opt/demo/
RUN chown -R 0:0 /out && chmod -R go-w /out

FROM registry.cloudflare.com/163867166be2a9e9a601132b1f3081a4/heddle-artifacts-engine@sha256:085fc19e7bc673d97204ca07e636c95cb51054658e1b0282f349549004e97445
COPY --from=files /out/opt/ /opt/
USER 65532:65532
WORKDIR /opt/engine
ENTRYPOINT ["engine"]
