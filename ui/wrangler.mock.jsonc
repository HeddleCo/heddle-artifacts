// SPDX-License-Identifier: Apache-2.0
// Local acceptance harness. Never deploy this mock Worker.
{
  "name": "heddle-ui-local-mock",
  "main": "mock-worker.ts",
  "compatibility_date": "2026-10-10",
  "durable_objects": { "bindings": [{ "name": "FIXTURE_PROJECT", "class_name": "FixtureProject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FixtureProject"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.jsonl"], "fallthrough": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/__mock/*", "/login", "/logout"] }
}
